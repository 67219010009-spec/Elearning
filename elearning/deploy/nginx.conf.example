# ตัวอย่างสำหรับเครื่อง Nginx (Ubuntu 1)
# - วางไฟล์ที่ได้จาก `npm run build` (โฟลเดอร์ frontend/dist) ไว้ที่ /var/www/elearning
# - แก้ API_HOST เป็น IP ของเครื่องที่รัน Express
server {
  listen 80;
  server_name _;

  root /var/www/elearning;
  index index.html;
  client_max_body_size 200m;   # ให้ตรงกับ MAX_UPLOAD_MB ของ backend

  location /api/ {
    proxy_pass http://API_HOST:3000;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
  }

  location /uploads/ {
    proxy_pass http://API_HOST:3000;
  }

  location / {
    try_files $uri /index.html;   # ให้ Vue Router ทำงานเมื่อรีเฟรชหน้า
  }
}
